# ====================== Binance Credentials ======================
# ALWAYS start with Testnet keys
# Create them at: https://testnet.binance.vision/
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# true = Binance Spot Testnet | false = Live (real money)
BINANCE_TESTNET=true

# ====================== Trading Settings =========================
# low | medium | high
RISK_PROFILE=medium

# Trading pair (must be available on the chosen market)
SYMBOL=BTC/USDT

# Candle timeframe
TIMEFRAME=1h

# true = simulate orders only (strongly recommended at first)
DRY_RUN=true

# Maximum number of open positions (overridden by risk profile if lower)
MAX_POSITIONS=2

# ====================== Logging ==================================
LOG_LEVEL=INFO
