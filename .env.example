# ====================== Mode ======================
# true = virtual $1000 + REAL Binance prices (recommended for first use)
# false = real/testnet trading (needs API keys)
PAPER_MODE=true
PAPER_BALANCE=1000

# Only needed when PAPER_MODE=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# ====================== Trading ======================
RISK_PROFILE=medium
STRATEGY=ema_rsi
SYMBOL=BTC/USDT
TIMEFRAME=1h

# ====================== Telegram ======================
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_ALLOWED_USERS=123456789

LOG_LEVEL=INFO
