# ====================== Binance Credentials ======================
# ALWAYS start with Testnet keys
# Create them at: https://testnet.binance.vision/
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# true = Binance Spot Testnet | false = Live (real money)
BINANCE_TESTNET=true

# ====================== Trading Settings =========================
# low | medium | high
RISK_PROFILE=medium

# Trading pair (must be available on the chosen market)
SYMBOL=BTC/USDT

# Candle timeframe
TIMEFRAME=1h

# true = simulate orders only (strongly recommended at first)
DRY_RUN=true

# ====================== Telegram Control =========================
# Create bot via @BotFather and get the token
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Your Telegram user ID(s) – comma separated. Only these users can control the bot.
# Get your ID from @userinfobot
TELEGRAM_ALLOWED_USERS=123456789

# ====================== Logging ==================================
LOG_LEVEL=INFO
